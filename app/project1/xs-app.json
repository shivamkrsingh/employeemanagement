{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "destination": "ui5",
      "authenticationType": "none"
    },
    {
      "source": "^/ZAPI_MANAGEMENT_SRV/(.*)$",
      "target": "/ZAPI_MANAGEMENT_SRV/$1",
      "destination": "employee-management-srv-api",
      "authenticationType": "xsuaa"
    }
  ]
}